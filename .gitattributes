# Shell scripts and systemd units must stay LF — a CRLF checkout installs
# "/bin/bash^M" on the VPS and systemd refuses the unit.
*.sh text eol=lf
deploy/healthlog.service text eol=lf
deploy/Caddyfile text eol=lf
*.js text eol=lf
*.mjs text eol=lf
*.json text eol=lf
*.yml text eol=lf
*.css text eol=lf
*.ts text eol=lf
*.html text eol=lf
*.md text eol=lf
